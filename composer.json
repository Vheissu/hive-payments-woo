{
  "name": "hive/payments-woo",
  "description": "Hive Payments for WooCommerce - tests",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "pestphp/pest": "^2.0",
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6"
  },
  "autoload-dev": {
    "psr-4": {
      "HivePayments\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "pest"
  }
}
